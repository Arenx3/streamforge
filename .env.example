# Copy to .env and fill in. Never commit .env.

# --- Django ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Reverse proxies in front of Django (1 = nginx; 2 = CDN + nginx).
TRUSTED_PROXY_COUNT=1
THROTTLE_RATE_LOGIN=10/minute
THROTTLE_RATE_REGISTER=10/hour
THROTTLE_RATE_EMAIL_VERIFY=20/hour
THROTTLE_RATE_EMAIL_RESEND=5/hour
THROTTLE_RATE_PASSWORD_RESET=5/hour
THROTTLE_RATE_PASSWORD_CONFIRM=10/hour
GUNICORN_WORKERS=3

# --- PostgreSQL ---
POSTGRES_DB=streamforge
POSTGRES_USER=streamforge
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
# Django cache (rate limits). Must not share a DB with Celery: cache.clear() flushes it.
CACHE_REDIS_URL=redis://redis:6379/2
CELERY_CONCURRENCY=2

# --- Local S3 server (RustFS) ---
STORAGE_CONSOLE_PORT=9001
STORAGE_API_PORT=9000

# --- S3 (boto3). Local RustFS reuses these credentials; point to Cloudflare R2 in prod ---
AWS_S3_ENDPOINT_URL=http://storage:9000
# Host browsers use to upload. In production, the public R2 endpoint.
AWS_S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=streamforge
AWS_SECRET_ACCESS_KEY=change-me-min-8-chars
AWS_STORAGE_BUCKET_NAME=streamforge-media
AWS_S3_REGION_NAME=us-east-1

# Video uploads (size in bytes, URL lifetime in seconds)
VIDEO_UPLOAD_MAX_BYTES=5368709120
VIDEO_UPLOAD_URL_EXPIRES=21600
VIDEO_UPLOAD_ABANDON_HOURS=24

# Video processing (seconds)
VIDEO_MAX_DURATION_SECONDS=14400
VIDEO_TRANSCODE_MAX_SECONDS=21600
VIDEO_STUCK_AFTER_SECONDS=180
# Lifetime of playback links (seconds)
VIDEO_PLAYBACK_URL_EXPIRES=21600

# Email. Locally, Mailpit catches every message: http://localhost:8025
# Production with Resend: EMAIL_HOST=smtp.resend.com, EMAIL_PORT=465, EMAIL_USE_SSL=True,
# EMAIL_HOST_USER=resend, EMAIL_HOST_PASSWORD=<API key>, DEFAULT_FROM_EMAIL on a verified domain.
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=StreamForge <no-reply@streamforge.local>
FRONTEND_URL=http://localhost:5173
MAILPIT_UI_PORT=8025
EMAIL_VERIFICATION_TTL_SECONDS=86400
PASSWORD_RESET_TTL_SECONDS=3600
ACCOUNT_UNVERIFIED_TTL_HOURS=72
AUTH_EMAIL_COOLDOWN_SECONDS=120
# Emails per day across all users (0 = no limit). 20% is kept for account recovery.
AUTH_EMAIL_DAILY_LIMIT=100
# Optional Slack or Discord webhook, called when email delivery fails.
EMAIL_ALERT_WEBHOOK_URL=

# Swagger UI at /api/docs/
API_DOCS_ENABLED=True

# --- Nginx ---
NGINX_PORT=80
