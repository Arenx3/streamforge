# Production overrides. Copy to .env on the server and replace every change-me.
# It assumes a proxy that terminates HTTPS in front of nginx (Caddy, Cloudflare Tunnel...).
# Anything left out keeps its default from .env.example.

# --- Django ---
# Generate it with: openssl rand -base64 48
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=False
# Keep localhost: the containers' own health checks use it.
DJANGO_ALLOWED_HOSTS=example.com,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com
CORS_ALLOWED_ORIGINS=https://example.com
FRONTEND_URL=https://example.com
# HTTPS proxy + nginx.
TRUSTED_PROXY_COUNT=2

# --- HTTPS ---
SECURE_SSL_REDIRECT=True
# Browsers remember this. Start low and raise it to 31536000 once HTTPS is proven.
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
# nginx believes the proxy's X-Forwarded-Proto, so nginx must not be reachable from outside.
BEHIND_TLS_PROXY=true
BIND_ADDRESS=127.0.0.1

# --- Database ---
POSTGRES_PASSWORD=change-me

# --- Storage (Cloudflare R2) ---
AWS_S3_ENDPOINT_URL=https://change-me.r2.cloudflarestorage.com
AWS_S3_PUBLIC_ENDPOINT_URL=https://change-me.r2.cloudflarestorage.com
AWS_ACCESS_KEY_ID=change-me
AWS_SECRET_ACCESS_KEY=change-me
AWS_S3_REGION_NAME=auto
# The browser talks straight to the bucket, so the CSP has to allow it.
NGINX_STORAGE_ORIGINS=https://change-me.r2.cloudflarestorage.com

# --- Public surface ---
DEMO_ENABLED=False
API_DOCS_ENABLED=False
MAILBOX_URL=
